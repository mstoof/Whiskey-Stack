# ─────────────────────────────────────────────────────────────
# Whiskey Stack — environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it holds secrets.
# ─────────────────────────────────────────────────────────────

# --- Database (Neon Postgres) -------------------------------------------------
# Neon Console → your project → Connect → copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Auth (Neon Auth, powered by Stack) --------------------------------------
# Neon Console → your project → Auth → Configuration / Setup.
# The first two are safe to expose to the browser; the third is server-only.
NEXT_PUBLIC_STACK_PROJECT_ID="your-stack-project-id"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="pck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STACK_SECRET_SERVER_KEY="ssk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- AI discovery (Google Gemini — primary provider) -------------------------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"
# Any current Gemini model that supports Google Search grounding.
GEMINI_MODEL="gemini-3.8-flash"

# --- AI fallback (OpenRouter — optional) --------------------------------------
# Hit Gemini's free-tier rate limits? Set these and lib/ai.ts will transparently
# fall back to OpenRouter (openrouter.ai) whenever Gemini returns a 429 — or, if
# you leave GEMINI_API_KEY unset entirely, use OpenRouter as the only provider.
# Get a key at https://openrouter.ai/keys (no card needed for :free models).
OPENROUTER_API_KEY=""
# REQUIRED if OPENROUTER_API_KEY is set — there's no hardcoded default because
# OpenRouter's free-model roster changes constantly. Pick a current one (a
# `:free` model needs no credits) at https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=""
# Optional: a separate model for label-photo scanning if OPENROUTER_MODEL
# doesn't support images. Defaults to OPENROUTER_MODEL.
OPENROUTER_VISION_MODEL=""
# Optional, default false. Without it, OpenRouter calls never claim a price —
# they have no live web access, so we'd rather return null than guess. Setting
# this to "true" attaches
# OpenRouter's `web` search plugin, which makes real pricing possible again
# but costs a small amount PER REQUEST even on free models — it is not free.
OPENROUTER_ENABLE_WEB=""

# --- App ----------------------------------------------------------------------
# Used for absolute links; on Vercel this is set automatically.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Price watch (Vercel Cron) -----------------------------------------------
# Secret that guards the daily /api/cron/price-watch route. Vercel Cron sends it
# automatically as `Authorization: Bearer <CRON_SECRET>`. Generate any long
# random string (e.g. `openssl rand -hex 32`). The scheduled endpoint returns
# an error until this is set.
CRON_SECRET="generate-a-long-random-string"

# --- Email notifications (optional, via Resend) ------------------------------
# Optional: enables the "price dropped" email. Leave both blank to keep price
# watch in-app only (it degrades gracefully). Get a key at https://resend.com
# and use a verified sender for EMAIL_FROM.
RESEND_API_KEY=""
EMAIL_FROM="Whiskey Stack <onboarding@resend.dev>"
